{
  "id": "pipes-bot-channel",
  "channels": ["pipes-bot"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "string",
        "minLength": 1,
        "pattern": "^pk_"
      }
    }
  },
  "uiHints": {
    "apiKey": {
      "label": "PipesBot API Key",
      "sensitive": true,
      "placeholder": "pk_..."
    }
  }
}
